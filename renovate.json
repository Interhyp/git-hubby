{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":semanticCommitTypeAll(fix)"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "golangci-lint version in the Makefile and the custom (plugin) build config, which must always match",
      "managerFilePatterns": ["/^Makefile$/", "/^\\.custom-gcl\\.yml$/"],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "(?:^|\\n)version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**", "github.com/onsi/**"],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions",
        "nodenv",
        "npm",
        "mise"
      ],
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": [
        "devcontainer"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Update the go directive in go.mod (Renovate leaves it alone by default unless out of range)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Bundle all Go toolchain bumps (go.mod, mise.toml, Dockerfile base image) into a single PR",
      "matchManagers": ["gomod", "mise", "dockerfile"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "go",
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["github.com/golangci/golangci-lint/v2"],
      "groupName": "golangci-lint",
      "semanticCommitType": "build"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
